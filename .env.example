# Copia este archivo a .env y completa los valores. NUNCA subas tu .env real.
# El .env está en .gitignore: solo este .env.example se versiona.

# --- Base de datos (Azure SQL Server, usuario de SOLO LECTURA) ---
DB_SERVER=tu-servidor.database.windows.net
DB_NAME=tu_base_de_datos
DB_USER=usuario_solo_lectura
DB_PASSWORD=tu_password
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_READ_TIMEOUT_SECONDS=30
DB_MAX_ROWS=1000

# --- Proveedor de modelos (OpenRouter, compatible con la API de OpenAI) ---
OPENROUTER_API_KEY=sk-or-tu-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Modelos por agente ---
MODEL_ID=qwen/qwen3-coder-30b
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2
ROUTER_MODEL_ID=meta-llama/llama-3.1-8b-instruct
SQL_GEN_MODEL_ID=qwen/qwen3-coder-30b-a3b-instruct
SQL_GEN_SEED=42
SQL_GEN_PROVIDER=Alibaba

# --- Límites de conversación y resultados ---
CONVERSATION_WINDOW=6
SQL_MAX_ROWS=100
EXPORT_MAX_ROWS=50000
